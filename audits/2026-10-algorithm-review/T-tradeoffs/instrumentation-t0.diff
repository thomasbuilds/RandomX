+	static void tpartPatch(uint8_t* p, size_t n, uint32_t off) {
+		for (size_t i = 0; i + 4 <= n; ++i) {
+			uint32_t v; memcpy(&v, p + i, 4);
+			if (v == 0x33333333u) { memcpy(p + i, &off, 4); i += 3; continue; }
+			if (v == 0x22222222u) { memcpy(p + i, &tpart_thresh, 4); i += 3; continue; }
+			if (v == 0x44444444u) { memcpy(p + i, &tpart_mask, 4); i += 3; continue; }
+			if (i + 8 <= n) {
+				uint64_t w; memcpy(&w, p + i, 8);
+				if (w == 0x1111111111111111ull) { memcpy(p + i, &tpart_base, 8); i += 7; continue; }
+			}
+		}
+	}
