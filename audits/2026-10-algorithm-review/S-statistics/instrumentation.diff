+//==== Agent S instrumentation (private copy, not part of RandomX) ====
+namespace rxs {
+	struct Instr {
+		uint64_t fpOps[4];          //rounding FP arithmetic instructions executed, by current rounding mode
+		uint64_t cfroundExec;       //CFROUND executions
+		uint64_t cfroundWrite;      //CFROUND executions that write fprc (v1: all, v2: gate passes)
+		uint64_t cfroundChange;     //writes that change the rounding mode
+		uint64_t cbranchExec, cbranchTaken;
+		uint64_t dynInstr;          //dynamic instruction count
+		uint32_t curMode;           //shadow of fprc
+		uint32_t mxcsrFlags;        //accumulated MXCSR status flags (bits 0-5)
+		//FP result classification per lane (results of FADD/FSUB/FMUL/FDIV/FSQRT/FSCAL)
+		uint64_t resLanes, resNaN, resDenorm, resInf, resZero;
+		//per-iteration CBRANCH bookkeeping
+		uint32_t jumpsIter, reexecIter;
+		int consecPc, consec, maxConsec;
+		uint64_t consecHist[8];     //histogram of consecutive jumps of one CBRANCH instance (1,2,3..)
+		uint64_t distHist[RANDOMX_PROGRAM_MAX_SIZE + 2]; //re-executed instructions per taken jump
+		//memory watch (one 8-byte word), used by influence experiments
+		int64_t watchWord;          //-1 = none
+		int watchEvent;             //0 none, 1 read first, 2 write first
+		//write coverage bitmap (8-byte words), nullptr = off
+		uint8_t* wbm;
+		//last-writer map (one byte per 8-byte word; ISTORE marks 3), nullptr = off
+		uint8_t* lw;
+	};
+	extern Instr G;
+	inline void classifyLane(uint64_t x) {
+		uint64_t ex = (x >> 52) & 0x7FF, man = x & ((1ULL << 52) - 1);
+		G.resLanes++;
+		if (ex == 0x7FF) { if (man) G.resNaN++; else G.resInf++; }
+		else if (ex == 0) { if (man) G.resDenorm++; else G.resZero++; }
+	}
+	inline void classifyVec(rx_vec_f128 v) {
+		alignas(16) uint64_t t[2];
+		rx_store_vec_f128((double*)t, v);
+		classifyLane(t[0]); classifyLane(t[1]);
+	}
+	inline void watchRead(uint32_t addr) {
+		if (G.watchWord >= 0 && G.watchEvent == 0 && (int64_t)(addr >> 3) == G.watchWord) G.watchEvent = 1;
+	}
+	inline void watchWrite(uint32_t addr) {
+		if (G.wbm) G.wbm[addr >> 6] |= (uint8_t)(1u << ((addr >> 3) & 7));
+		if (G.lw) G.lw[addr >> 3] = 3;
+		if (G.watchWord >= 0 && G.watchEvent == 0 && (int64_t)(addr >> 3) == G.watchWord) G.watchEvent = 2;
+	}
+}
 
