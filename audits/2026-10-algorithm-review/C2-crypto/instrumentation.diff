diff -ruN a/src/instr_hooks.hpp b/src/instr_hooks.hpp
--- a/src/instr_hooks.hpp
+++ b/src/instr_hooks.hpp
@@ -0,0 +1,16 @@
+// Agent C2 instrumentation hooks (private copy; not part of RandomX)
+#pragma once
+#include <cstdint>
+namespace instr {
+	struct Tracker {
+		virtual ~Tracker() {}
+		// scratchpad offset and size in bytes; kind: 0 = instr read, 1 = step2 line read, 2 = step3 line read
+		virtual void read(uint32_t off, uint32_t size, int kind) {}
+		// kind: 0 = ISTORE, 1 = step9 (integer regs), 2 = step11 (F regs)
+		virtual void write(uint32_t off, uint32_t size, int kind) {}
+		virtual void iterEnd() {}
+		// v1/v2 step 10: F before mixing, E (keys), F after mixing (each 64 bytes)
+		virtual void mix(const void* fpre, const void* e, const void* fpost) {}
+	};
+	extern thread_local Tracker* g;
+}
